{
  "name": "bookend-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:live": "dotenv -e .env.local -v RAMP_LIVE=1 -- vitest run src/ramp/contract.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "spike": "dotenv -e .env.local -- tsx scripts/ramp-spike.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@clerk/nextjs": "^7.9.25",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
