# Copy to .env.local and fill in. Never commit .env.local.
# See the README for what each service does, and what happens without it.

# Ramp sandbox app, from https://demo.ramp.com/settings/ramp-developer
RAMP_CLIENT_ID=
RAMP_CLIENT_SECRET=
# Optional: the Ramp user who owns funds made by the spike script.
# Blank uses the first active non-guest.
SPIKE_USER_ID=
# Needed to show card details to the crew.
RAMP_BUSINESS_ID=
# From registering the webhook.
RAMP_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Required in production. Generated for you locally.
DATABASE_URL=
APP_SECRET=
CRON_SECRET=
APP_URL=

# Claude calls allowed per org per month.
MONTHLY_AI_LIMIT=300
